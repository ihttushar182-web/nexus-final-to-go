# ─────────────────────────────────────────────────────────────────────────────
# Nexus Lift — environment configuration
# Copy to .env.local and fill in real values. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=nexusliftbd@gmail.com
NEXT_PUBLIC_WHATSAPP_NUMBER=+8801814716713
NEXT_PUBLIC_PHONE_DISPLAY=01814716713
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/nexusliftbd
NEXT_PUBLIC_MESSENGER_URL=
NEXT_PUBLIC_ANALYTICS_ID=

# ── Database (Supabase / PostgreSQL) ─────────────────────────────────────────
# When these are absent the app runs on the local persistent store
# (DB_DRIVER=local) so that development and preview work without credentials.
DB_DRIVER=local
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Local store (DB_DRIVER=local only) ───────────────────────────────────────
LOCAL_DB_DIR=.data

# ── Admin / CRM authentication ───────────────────────────────────────────────
# Generate a scrypt hash with:
#   node scripts/hash-password.mjs "your-password"
#
# PRODUCTION REQUIRES ADMIN_PASSWORD_HASH. A plaintext ADMIN_PASSWORD is refused
# when NODE_ENV=production, so a shared development password can never become a
# production credential. ADMIN_PASSWORD is accepted in development only.
# AUTH_SECRET must be a long random string; changing it signs everyone out.
ADMIN_EMAIL=admin@nexuslift.com
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=change-me-in-production
AUTH_SECRET=change-me-to-a-long-random-string

# ── Automation (n8n) ─────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=change-me-n8n-secret
N8N_ALLOWED_IPS=

# ── Meta (Facebook Messenger) ────────────────────────────────────────────────
META_PAGE_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_PROVIDER_KEY=
EMAIL_FROM="Nexus Lift <nexusliftbd@gmail.com>"

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# ── Feature flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_CHECKOUT=false
NEXT_PUBLIC_ENABLE_PORTAL=false
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=false
